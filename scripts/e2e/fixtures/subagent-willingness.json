    {
      "id": "beamer-single-visual-precheck",
      "category": "subagent-default/visual",
      "fixture": "visual-beamer-deck",
      "repeat": 1,
      "timeoutSeconds": 480,
      "tools": ["todo", "task", "hub", "read", "grep", "glob", "write", "edit"],
      "prompt": "Create the small Beamer deck in main.tex while preserving its template and frame story. First write the text-only page draft to slides-content.md in section-sized batches and discuss every page with the user, with one Markdown entry per page covering title, narrative job, body, evidence, and visual role. Treat the Markdown content plan as the canonical content source and the page-content confirmation as supplied for this fixture. Do not write Beamer frames or perform layout while content is unresolved. After that confirmation, translate the confirmed Markdown plan into Beamer frames, add visuals page by page, establish the basic layout, and do not shorten the .tex content; keep complete sentences rather than phrases or keywords. If content changes, edit slides-content.md first, reconfirm the affected pages, regenerate Beamer, and only then resume layout. Treat the basic-layout confirmation as supplied before entering the existing visual refinement stage. Have task compile and render the initial revision and bind the stable revision=rev-1 identifier to its PDF and page renders. Then perform exactly one single read-only visual precheck owned by task or Main (choose one owner only) before designer performs the final layout pass. Have task integrate the final revision=rev-1, rerender it, and bind fresh current revision evidence for visioner. Have visioner independently review the current revision. PowerPoint conversion is out of scope without an exact user-supplied conversion command; with no conversion command, do not convert.",
      "expectations": {
        "minNativeTaskCalls": 4,
        "maxNativeTaskCalls": 7,
        "minNativeTaskAssignmentAttempts": 4,
        "maxNativeTaskAssignmentAttempts": 7,
        "requireNativeTaskCompletion": true,
        "requireNativeTaskSubmissionForEveryAssignment": true,
        "requireNonemptyNativeTaskContext": true,
        "requiredNativeTaskAgents": ["task", "designer", "visioner"],
        "requiredNativeTaskAgentSequence": ["task", "designer", "task", "visioner"],
        "requiredObservedSkills": ["omp-enhancer-workflows", "latex-beamer-slides"],
        "maxObservedSkills": 3,
        "forbiddenSkills": ["beamer-to-powerpoint", "drawio-skill"],
        "requiredWorkflowPrimary": "writing",
        "requiredSelectedWorkflowIds": ["writing"],
        "requiredNativeTaskAssignmentTextBounds": [
          {
            "agent": "task",
            "pattern": "initial.+render",
            "minCount": 1,
            "maxCount": 1,
            "beforeAssignmentAgent": "designer"
          },
          {
            "agent": "task",
            "pattern": "single read-only visual precheck",
            "minCount": 1,
            "maxCount": 1,
            "beforeAssignmentAgent": "designer"
          }
        ],
        "requiredNativeTaskDeliveryTextPatterns": [
          {
            "agent": "task",
            "pattern": "final.+revision=rev-[0-9]+",
            "minCount": 1,
            "maxCount": 2
          },
          {
            "agent": "visioner",
            "pattern": "current.+revision=rev-[0-9]+",
            "minCount": 1,
            "maxCount": 2
          }
        ],
        "requiredNativeTaskDeliveryRevisionMatch": {
          "sourceAgent": "task",
          "sourcePattern": "final.+revision=rev-[0-9]+",
          "targetAgent": "visioner",
          "targetPattern": "current.+revision=rev-[0-9]+"
        },
        "forbiddenNativeTaskAssignmentTextPatterns": [
          "APPROVED|CHANGES_REQUIRED|UNREVIEWABLE",
          "single read-only visual precheck[^\\n]*(?:parallel|dual|fallback|disagreement|merge)"
        ],
        "requiredFileWriteOrder": [
          { "before": "slides-content.md", "after": "main.tex" }
        ],
        "maxToolCalls": 60
      },
      "fixtureExpectations": {
        "allowedChangedFiles": ["main.tex", "slides-content.md"],
        "requiredChangedFiles": ["main.tex", "slides-content.md"],
        "requiredPatterns": {
          "main.tex": ["documentclass\\{beamer\\}", "\\\\begin\\{frame\\}", "Baseline"],
          "slides-content.md": ["## Page", "Title", "Narrative job", "Body", "Evidence", "Visual role"]
