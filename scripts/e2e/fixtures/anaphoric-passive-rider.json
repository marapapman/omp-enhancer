{
  "version": 1,
  "defaults": {
    "approvalMode": "yolo",
    "advisor": false,
    "executionMode": "rpc",
    "timeoutSeconds": 300,
    "tools": ["read", "edit", "polisher", "writing_ai_scan"],
    "repeat": 1,
    "expectations": {
      "noWeb": true,
      "requireFinal": true,
      "requiredToolCalls": [
        {
          "name": "polisher",
          "min": 1,
          "argumentsPattern": "(?:path\\.join|它)[^。\\n]*Documents[^。\\n]*report\\.txt[^。\\n]*补上斜杠"
        }
      ],
      "requiredToolCallBeforeFileWrite": [
        {
          "tool": "polisher",
          "file": "paper.md"
        }
      ],
      "forbiddenToolCalls": ["task"]
    }
  },
  "scenarios": [
    {
      "id": "zh-anaphoric-passive-rider-delivery",
      "category": "writing/zh-anaphoric-passive-rider",
      "fixture": "anaphoric-passive-rider-zh",
      "prompt": "润色 paper.md，只修改这个文件。保留 path.join、Documents、report.txt 和补上斜杠这些事实。Main 自己起草修改后的正文，调用 polisher 取得润色后的文字，并把返回的文字原样写回 paper.md；writer 和 checker 代理已经移除，不要派发任何代理。修改后只简要报告，不复读原句。",
      "expectations": {
        "forbiddenFinalPatterns": [
          "(?<!里)(?<!中)(?<!下)(?<!时)(?<!后)(?<!前)(?<!以来)(?<!以前)(?<!方面)[，,](?!因为|由于|如果|若|当|除非|虽然|尽管|即使|所以|因此|因而|于是|但|但是|而|否则)[^，。！？；,.!?;\\n]{1,24}由(?:它们|它|其(?!他|中|余)|该[^，。！？；,.!?;\\n]{0,8}|这个[^，。！？；,.!?;\\n]{0,8}|这种[^，。！？；,.!?;\\n]{0,8}|上述[^，。！？；,.!?;\\n]{0,8}|此[^，。！？；,.!?;\\n]{0,8})[^，。！？；,.!?;\\n]{1,16}(?=[。！？.!?，,；;]|$)"
        ]
      },
      "fixtureExpectations": {
        "allowedChangedFiles": ["paper.md"],
        "requiredChangedFiles": ["paper.md"],
        "requiredPatterns": {
          "paper.md": [
            "path\\.join",
            "Documents",
            "report\\.txt",
            "(?:path\\.join|它)[^。\\n]*Documents[^。\\n]*report\\.txt[^。\\n]*补上斜杠"
          ]
        },
        "forbiddenPatterns": {
          "paper.md": [
            "(?<!里)(?<!中)(?<!下)(?<!时)(?<!后)(?<!前)(?<!以来)(?<!以前)(?<!方面)[，,](?!因为|由于|如果|若|当|除非|虽然|尽管|即使|所以|因此|因而|于是|但|但是|而|否则)[^，。！？；,.!?;\\n]{1,24}由(?:它们|它|其(?!他|中|余)|该[^，。！？；,.!?;\\n]{0,8}|这个[^，。！？；,.!?;\\n]{0,8}|这种[^，。！？；,.!?;\\n]{0,8}|上述[^，。！？；,.!?;\\n]{0,8}|此[^，。！？；,.!?;\\n]{0,8})[^，。！？；,.!?;\\n]{1,16}(?=[。！？.!?，,；;]|$)"
          ]
        }
      }
    }
  ]
}
