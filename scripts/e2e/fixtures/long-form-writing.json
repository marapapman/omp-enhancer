{
  "version": 1,
  "defaults": {
    "approvalMode": "yolo",
    "advisor": false,
    "executionMode": "rpc",
    "taskEager": "preferred",
    "tools": ["todo", "task", "hub", "read", "grep", "glob", "write", "edit"],
    "repeat": 3,
    "timeoutSeconds": 1500,
    "expectations": {
      "noWeb": true,
      "requireFinal": true,
      "maxPrimaryFinals": 1,
      "maxAdvisorMessages": 0,
      "maxPostFinalAdvisorMessages": 0,
      "noUnobservedSkillClaims": true,
      "requireSuccessfulToolCalls": true,
      "maxDuplicateFailedCalls": 0,
      "maxDuplicateSkillReadAttempts": 0,
      "maxAbortedAssistants": 0,
      "pluginContinuationCount": 0,
      "requireWorkflowIndexOnlyFirstToolBatch": true,
      "requireWorkflowPlanBeforeResourceLoads": true,
      "requireStructuredWorkflowLoadPhases": true,
      "requiredWorkflowPlanFormat": "block",
      "minWorkflowPlanNumberedActions": 4,
      "requireWorkflowPlanFirstVisibleContent": true,
      "forbidResourceProjectSameBatch": true,
      "requireWorkflowReadyAfterLoadsBeforeProjectTools": true,
      "requireWorkflowReadyTodoOnlyBatch": true,
      "requireExactSelectedWorkflowReferences": true,
      "requireWorkflowPlanSkillsUseDomainSkillUris": true,
      "requireWorkflowReadyLoadedSkillsUseBareIds": true,
      "requireWorkflowReadyLoadedSkillsMatchSuccessfulDomainSkills": true
    }
  },
  "scenarios": [
    {
      "id": "trivial-lookup",
      "category": "negative/trivial-lookup",
      "cwd": ".",
      "prompt": "Read README.md and return only its first Markdown heading verbatim. Do not modify files, delegate, or use the network.",
      "expectations": {
        "maxNativeTaskCalls": 0,
        "maxNativeTaskAssignmentAttempts": 0,
        "maxNativeTodoCalls": 0,
        "forbidWorkflowMarkers": true,
        "requireStructuredWorkflowLoadPhases": false,
        "requireWorkflowPlanSkillsUseDomainSkillUris": false,
        "requireWorkflowReadyLoadedSkillsUseBareIds": false,
        "requireWorkflowReadyLoadedSkillsMatchSuccessfulDomainSkills": false,
        "requireWorkflowIndexOnlyFirstToolBatch": false,
        "requireWorkflowPlanBeforeResourceLoads": false,
        "requireWorkflowPlanFirstVisibleContent": false,
        "requireWorkflowReadyAfterLoadsBeforeProjectTools": false,
        "requireWorkflowReadyTodoOnlyBatch": false,
        "requireExactSelectedWorkflowReferences": false,
        "forbiddenSkills": ["omp-enhancer-workflows"],
        "maxToolCalls": 2,
        "maxSourceSearchCalls": 2
      }
    },
    {
      "id": "ordinary-writing",
      "category": "control/ordinary-writing",
      "fixture": "substantive-writing-en-readonly",
      "tools": ["todo", "task", "hub", "read", "grep", "glob"],
      "prompt": "Read the two English LaTeX paragraphs in section.tex and propose a conservative revision that improves their claim-evidence relationship, resolves the ambiguous phrase 'This improvement', and makes the comparison between stopping rules easier to follow. Preserve every qualifier, modality, negation, number, citation, LaTeX command, experimental limitation, and the distinction between observed results and an equal-compute counterfactual. Independently check the complete proposed revision for semantic drift and explain the final wording. Do not modify files, delegate more than one writer and one checker, or use the network.",
      "expectations": {
        "minNativeTaskCalls": 2,
        "maxNativeTaskCalls": 3,
        "minNativeTaskAssignmentAttempts": 2,
        "maxNativeTaskAssignmentAttempts": 3,
        "requireNativeTaskCompletion": true,
        "requireNativeTaskSubmissionForEveryAssignment": true,
        "requireNonemptyNativeTaskContext": true,
        "requireNativeTaskMetadataPrefix": true,
        "requireExactNativeTaskMetadataPrefix": true,
        "requireNativeTaskMetadataMatchesDelegatedTodoRows": true,
        "requiredNativeTaskAgents": ["writer", "checker"],
        "requiredNativeTaskAgentSequence": ["writer", "checker"],
        "forbiddenNativeTaskAgents": ["reviewer"],
        "requiredNativeTaskWorkflows": ["writing.en", "writing.latex"],
        "requiredNativeTaskWorkflowsPerAssignment": ["writing.en", "writing.latex"],
        "requiredNativeTaskSkillsPerAssignment": ["writing-review"],
        "requiredObservedSkills": ["omp-enhancer-workflows", "writing-review"],
        "requiredWorkflowPrimary": "writing.en",
        "requiredSelectedWorkflowIds": ["writing.en", "writing.latex"],
        "requiredWorkflowLoadOrder": [
          "skill://writing-review",
          "skill://omp-enhancer-workflows/references/writing.latex.md",
          "skill://omp-enhancer-workflows/references/writing.en.md"
        ],
        "requireWorkflowResourceCallsMatchLoadOrder": true,
        "requireNativeTodoInit": true,
        "minNativeTodoItems": 3,
        "requireNativeTodoCompletion": true,
        "requireNativeTodoInitBeforeSubstantiveTool": true,
        "maxProjectInspectionCallsBeforeNativeTask": 0,
        "maxProjectInspectionCallsAfterNativeTask": 1
      }
    },
    {
      "id": "long-form-single-agent-baseline",
      "category": "wave0/single-agent-long-form-baseline",
      "fixture": "long-form-writing-baseline",
      "tools": ["todo", "task", "hub", "read", "grep", "glob", "write", "edit"],
      "prompt": "Treat this temporary project as the target of a long-form writing baseline. Read brief.md for the frozen terminology and voice, then draft the full article into article.md in a single writer pass covering all three sections below, and have one independent checker review the integrated draft for semantic drift before finalizing. Sections: (1) 'Orchestration primitives' — what orchestrator-worker, maker-checker, and fan-out mean and when each fits; (2) 'Context isolation' — why subagent context isolation saves tokens and what it costs; (3) 'Single-agent first' — the empirical case for trying one agent before fanning out. Each section uses the frozen terminology and cites (Orchestration Plan 2026). Use exactly one writer assignment for the whole draft and one checker assignment after the parent integrates the draft into article.md; do not fan out one writer per section. Do not use the network.",
      "expectations": {
        "minNativeTaskCalls": 2,
        "maxNativeTaskCalls": 3,
        "minNativeTaskAssignmentAttempts": 2,
        "maxNativeTaskAssignmentAttempts": 3,
        "requireNativeTaskCompletion": true,
        "requireNativeTaskSubmissionForEveryAssignment": true,
        "requireNonemptyNativeTaskContext": true,
        "requireNativeTaskMetadataPrefix": true,
        "requireExactNativeTaskMetadataPrefix": true,
        "requireNativeTaskMetadataMatchesDelegatedTodoRows": true,
        "requiredNativeTaskAgents": ["writer", "checker"],
        "requiredNativeTaskAgentSequence": ["writer", "checker"],
        "forbiddenNativeTaskAgents": ["reviewer"],
        "requiredObservedSkills": ["omp-enhancer-workflows", "writing-review"],
        "requiredWorkflowPrimary": "writing.en",
        "requiredSelectedWorkflowIds": ["writing.en"],
        "requireWorkflowResourceCallsMatchLoadOrder": true,
        "requireNativeTodoInit": true,
        "minNativeTodoItems": 3,
        "requireNativeTodoCompletion": true,
        "requireNativeTodoInitBeforeSubstantiveTool": true,
        "maxProjectInspectionCallsBeforeNativeTask": 0,
        "maxProjectInspectionCallsAfterNativeTask": 6
      },
      "fixtureExpectations": {
        "allowedChangedFiles": ["article.md"],
        "requiredChangedFiles": ["article.md"]
      }
    },
    {
      "id": "long-form-pilot",
      "category": "wave3/long-form-pilot-positive",
      "fixture": "long-form-writing",
      "tools": ["todo", "task", "hub", "read", "grep", "glob", "write", "edit"],
      "prompt": "Treat this temporary project as the target of a long-form writing task. Read brief.md for the frozen terminology and voice, then draft a NEW article into article.md with exactly three independently specifiable sections, each with a complete disjoint brief below. Fan out one writer assignment per section in the same native task batch when batching is available, then integrate all writer proposals into article.md as the parent, then run exactly one checker assignment on the integrated draft, then apply at most one repair writer if the checker reports a material finding. Sections: (1) 'Orchestration primitives' — define orchestrator-worker, maker-checker, and fan-out; explain when each fits; give one concrete trigger per pattern; cite (Orchestration Plan 2026); (2) 'Context isolation' — explain why subagent context isolation saves tokens, what it costs, and the parent-delivery contract; cite (Orchestration Plan 2026); (3) 'Single-agent first' — present the empirical case for trying one agent before fanning out, including the Princeton single-agent result; mark any unverified claim [INFERENCE]. Each section's brief is disjoint: do not reference another section's content. The shared terminology and voice in brief.md are frozen and apply to every section. Writers are proposal-only: they return the full section text and never write article.md; the parent owns integration and the authorized write. Do not use a native reviewer. Do not use the network.",
      "expectations": {
        "requireLongFormWritingPilot": {
          "integrationTarget": "article.md",
          "maxRepairWriters": 1
        },
        "minNativeTaskCalls": 2,
        "maxNativeTaskCalls": 3,
        "minNativeTaskAssignmentAttempts": 4,
        "maxNativeTaskAssignmentAttempts": 5,
        "requireNativeTaskCompletion": true,
        "requireNativeTaskSubmissionForEveryAssignment": true,
        "requireNonemptyNativeTaskContext": true,
        "requireNativeTaskMetadataPrefix": true,
        "requireExactNativeTaskMetadataPrefix": true,
        "requireNativeTaskMetadataMatchesDelegatedTodoRows": true,
        "forbiddenNativeTaskAgents": ["reviewer"],
        "requiredObservedSkills": ["omp-enhancer-workflows", "writing-review"],
        "requiredWorkflowPrimary": "writing.en",
        "requiredSelectedWorkflowIds": ["writing.en"],
        "requireWorkflowResourceCallsMatchLoadOrder": true,
        "requireWorkflowPlanFirstVisibleContent": true,
        "requireNativeTodoInit": true,
        "minNativeTodoItems": 4,
        "requireNativeTodoCompletion": true,
        "requireNativeTodoInitBeforeSubstantiveTool": true,
        "maxProjectInspectionCallsBeforeNativeTask": 0,
        "maxProjectInspectionCallsAfterNativeTask": 2
      },
      "fixtureExpectations": {
        "allowedChangedFiles": ["article.md"],
        "requiredChangedFiles": ["article.md"]
      }
    }
  ]
}