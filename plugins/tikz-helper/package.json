{
  "name": "tikz-helper",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "OMP TikZ and OpenTikZ workflow resources with active-by-default catalog, asset preparation, and isolated rendering tools.",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "mcp-server.js",
    ".mcp.json",
    "src",
    "skills",
    "vendor",
    "package.json",
    "README.md"
  ],
  "bin": {
    "tikz-helper-mcp": "./mcp-server.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "omp": {
    "extensions": [
      "./index.js"
    ]
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "keywords": [
    "pi-package",
    "omp",
    "omp-plugin",
    "tikz",
    "latex",
    "opentikz",
    "diagrams"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "elkjs": "^0.12.0",
    "@thi.ng/geom-isec": "^4.0.78",
    "isect": "^3.0.2",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "puppeteer": "^24.15.0"
  }
}
