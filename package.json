{
  "name": "omp-enhancer-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "plugins/omp-config",
    "plugins/writing-helper",
    "plugins/omp-fact-checker",
    "plugins/volcengine-coding-plan"
  ],
  "scripts": {
    "test": "npm run check:workflows && node --test scripts/*.test.js && npm test --workspaces --if-present",
    "generate:workflows": "node scripts/generate-workflow-catalog.js --write",
    "check:workflows": "node scripts/generate-workflow-catalog.js --check",
    "generate:marketplace": "node scripts/check-marketplace.js --write",
    "pack:all": "node scripts/pack-all.js",
    "check:marketplace": "node scripts/check-marketplace.js",
    "release": "node scripts/release.js",
    "e2e:main": "node scripts/e2e/run-installed-workflow.mjs",
    "e2e:main:default-profile": "node scripts/e2e/assert-default-main-profile.mjs",
    "e2e:main:skills": "node scripts/e2e/run-installed-workflow.mjs --matrix scripts/e2e/fixtures/skill-discovery.json",
    "e2e:main:subagents": "node scripts/e2e/run-installed-workflow.mjs --matrix scripts/e2e/fixtures/subagent-willingness.json",
    "e2e:main:advisor": "node scripts/e2e/run-installed-workflow.mjs --matrix scripts/e2e/fixtures/advisor-stress.json",
    "e2e:main:self-iteration": "node scripts/e2e/run-installed-workflow.mjs --matrix scripts/e2e/fixtures/self-iteration.json"
  }
}
